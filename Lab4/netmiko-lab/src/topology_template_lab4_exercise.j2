interface GigabitEthernet1
 no shutdown
!
interface {{ loopback.name }}
 description Router ID Loopback
 ip address {{ loopback.ip }} {{ loopback.mask }}
!
{% for sub_int in sub_interfaces %}
interface {{ sub_int.name }}
 encapsulation dot1Q {{ sub_int.vlan }}
 ip address {{ sub_int.ip }} {{ sub_int.mask }}
 no shutdown
!
{% endfor %}
exit
!
router rip
 version 2
 no auto-summary
{% for network in rip_networks %}
 network {{ network }}
{% endfor %}
